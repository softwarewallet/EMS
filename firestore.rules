rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for validating fields
    function incoming() {
      return request.resource.data;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }

    // Tenants collection
    match /tenants/{tenantId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Campuses collection
    match /campuses/{campusId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Buildings & Classrooms
    match /buildings/{buildingId} {
      allow read, write: if true;
    }

    match /classrooms/{classroomId} {
      allow read, write: if true;
    }

    // Academic Years
    match /academic_years/{yearId} {
      allow read, write: if true;
    }

    // Classes & Grades
    match /classes/{classId} {
      allow read, write: if true;
    }

    // Sections
    match /sections/{sectionId} {
      allow read, write: if true;
    }

    // Subjects
    match /subjects/{subjectId} {
      allow read, write: if true;
    }

    // Users
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Students
    match /students/{studentId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Attendance (Phase 7.1)
    match /student_attendance/{attendanceId} {
      allow read, create, update, delete: if true;
    }

    match /attendance_sessions/{sessionId} {
      allow read, create, update, delete: if true;
    }

    match /attendance_corrections/{correctionId} {
      allow read, create, update, delete: if true;
    }

    match /attendance_configs/{configId} {
      allow read, create, update, delete: if true;
    }

    match /staff_attendance/{staffAttendanceId} {
      allow read, create, update, delete: if true;
    }

    // Exit Management & Clearance (Phase 6.4A)
    match /exit_requests/{requestId} {
      allow read, create, update, delete: if true;
    }

    match /clearance_cases/{caseId} {
      allow read, create, update, delete: if true;
    }

    match /clearance_items/{itemId} {
      allow read, create, update, delete: if true;
    }

    match /exit_configs/{configId} {
      allow read, create, update, delete: if true;
    }

    // Transfer Certificates & Exit Documentation (Phase 6.4B)
    match /certificates/{certificateId} {
      allow read, create, update, delete: if true;
    }

    match /certificate_snapshots/{snapshotId} {
      allow read, create, update, delete: if true;
    }

    match /certificate_templates/{templateId} {
      allow read, create, update, delete: if true;
    }

    match /certificate_numbering_configs/{configId} {
      allow read, create, update, delete: if true;
    }

    match /authorized_signatories/{signatoryId} {
      allow read, create, update, delete: if true;
    }

    // Audit logs (append-only)
    match /audit_logs/{auditId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // Phase 7.13 & 7.26 Student Support, Wellness, Grievance, Counseling & Safeguarding Governance
    match /student_support_cases/{caseId} {
      allow read: if resource.data.tenantId == request.auth.token.tenantId && 
                  (!resource.data.campusId || resource.data.campusId == request.auth.token.campusId);
      allow create: if request.resource.data.tenantId == request.auth.token.tenantId;
      allow update: if resource.data.tenantId == request.auth.token.tenantId;
      allow delete: if false; // Immutable governance audit
    }

    match /student_support_case_versions/{versionId} {
      allow read: if resource.data.tenantId == request.auth.token.tenantId;
      allow create: if request.resource.data.tenantId == request.auth.token.tenantId;
      allow update, delete: if false;
    }

    match /student_support_health_encounters/{encounterId} {
      allow read, create, update: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
      allow delete: if false;
    }

    match /student_support_wellness_observations/{obsId} {
      allow read, create, update: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_counseling_cases/{caseId} {
      allow read, create, update: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_counseling_sessions/{sessionId} {
      allow read, create, update: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_plans/{planId} {
      allow read, create, update: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_referrals/{referralId} {
      allow read, create, update: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_consents/{consentId} {
      allow read, create, update: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_communications/{commId} {
      allow read, create, update: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_accommodations/{accommodationId} {
      allow read, create, update: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_incidents/{incidentId} {
      allow read, create, update: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_emergency_overrides/{overrideId} {
      allow read, create: if request.resource.data.tenantId == request.auth.token.tenantId;
      allow update, delete: if false;
    }

    match /student_support_assignments/{id} {
      allow read, write: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_action_plans/{id} {
      allow read, write: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_action_items/{id} {
      allow read, write: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_follow_ups/{id} {
      allow read, write: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_escalations/{id} {
      allow read, write: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_disclosures/{id} {
      allow read, write: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_case_reviews/{id} {
      allow read, write: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_case_documents/{id} {
      allow read, write: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_case_comments/{id} {
      allow read, write: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_welfare_interventions/{id} {
      allow read, write: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_grievances/{id} {
      allow read, write: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_safeguarding_concerns/{id} {
      allow read, write: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_safeguarding_cases/{id} {
      allow read, write: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
    }

    match /student_support_analytics_cache/{cacheId} {
      allow read, create, update: if resource.data.tenantId == request.auth.token.tenantId || request.resource.data.tenantId == request.auth.token.tenantId;
      allow delete: if false;
    }

    // Phase 7.14 Communications & Notifications Governance
    match /communication_templates/{templateId} {
      allow read, create, update, delete: if true;
    }

    match /communication_template_versions/{versionId} {
      allow read, create, update, delete: if true;
    }

    match /communication_announcements/{announcementId} {
      allow read, create, update, delete: if true;
    }

    match /communication_campaigns/{campaignId} {
      allow read, create, update, delete: if true;
    }

    match /communication_messages/{messageId} {
      allow read, create, update, delete: if true;
    }

    match /communication_deliveries/{deliveryId} {
      allow read, create, update, delete: if true;
    }

    match /communication_acknowledgements/{ackId} {
      allow read, create, update, delete: if true;
    }

    match /communication_preferences/{prefId} {
      allow read, create, update, delete: if true;
    }

    match /communication_consents/{consentId} {
      allow read, create, update, delete: if true;
    }

    match /communication_threads/{threadId} {
      allow read, create, update, delete: if true;
    }

    match /communication_thread_messages/{threadMsgId} {
      allow read, create, update, delete: if true;
    }

    match /communication_analytics_cache/{cacheId} {
      allow read, create, update, delete: if true;
    }

    match /communication_escalations/{escalationId} {
      allow read, create, update, delete: if true;
    }

    // Phase 7.15A - Library & Learning Resources
    match /library_profiles/{libraryId} {
      allow read, create, update, delete: if true;
    }

    match /library_resources/{resourceId} {
      allow read, create, update, delete: if true;
    }

    match /library_resource_versions/{versionId} {
      allow read, create, update, delete: if true;
    }

    match /library_resource_copies/{copyId} {
      allow read, create, update, delete: if true;
    }

    match /library_resource_authors/{authorId} {
      allow read, create, update, delete: if true;
    }

    match /library_resource_publishers/{publisherId} {
      allow read, create, update, delete: if true;
    }

    match /library_resource_categories/{categoryId} {
      allow read, create, update, delete: if true;
    }

    match /library_resource_locations/{locationId} {
      allow read, create, update, delete: if true;
    }

    match /library_resource_identifiers/{identifierId} {
      allow read, create, update, delete: if true;
    }

    match /library_resource_subject_mappings/{mappingId} {
      allow read, create, update, delete: if true;
    }

    match /library_resource_curriculum_mappings/{mappingId} {
      allow read, create, update, delete: if true;
    }

    match /library_memberships/{membershipId} {
      allow read, create, update, delete: if true;
    }

    match /library_acquisitions/{acquisitionId} {
      allow read, create, update, delete: if true;
    }

    match /library_analytics_cache/{cacheId} {
      allow read, create, update, delete: if true;
    }

    // Phase 7.15B - Library Circulation & Fines
    match /library_loans/{loanId} {
      allow read, create, update, delete: if true;
    }

    match /library_returns/{returnId} {
      allow read, create, update, delete: if true;
    }

    match /library_renewals/{renewalId} {
      allow read, create, update, delete: if true;
    }

    match /library_reservations/{reservationId} {
      allow read, create, update, delete: if true;
    }

    match /library_holds/{holdId} {
      allow read, create, update, delete: if true;
    }

    match /library_fines/{fineId} {
      allow read, create, update, delete: if true;
    }

    match /library_fine_adjustments/{adjustmentId} {
      allow read, create, update, delete: if true;
    }

    match /library_lost_items/{lostId} {
      allow read, create, update, delete: if true;
    }

    match /library_damage_reports/{damageId} {
      allow read, create, update, delete: if true;
    }

    match /library_circulation_policies/{policyId} {
      allow read, create, update, delete: if true;
    }

    match /library_circulation_policy_versions/{versionId} {
      allow read, create, update, delete: if true;
    }

    match /library_circulation_analytics_cache/{cacheId} {
      allow read, create, update, delete: if true;
    }

    // Phase 7.16 - Examination Operations & Assessment Administration
    match /exam_sessions/{sessionId} {
      allow read, create, update, delete: if true;
    }

    match /exam_papers/{paperId} {
      allow read, create, update, delete: if true;
    }

    match /exam_seating_allocations/{allocationId} {
      allow read, create, update, delete: if true;
    }

    match /exam_invigilator_assignments/{assignmentId} {
      allow read, create, update, delete: if true;
    }

    match /exam_presences/{presenceId} {
      allow read, create, update, delete: if true;
    }

    match /exam_incidents/{incidentId} {
      allow read, create, update, delete: if true;
    }

    match /exam_result_processings/{processingId} {
      allow read, create, update, delete: if true;
    }

    match /exam_moderation_requests/{requestId} {
      allow read, create, update, delete: if true;
    }

    match /exam_exceptions/{exceptionId} {
      allow read, create, update, delete: if true;
    }

    match /exam_ops_analytics_cache/{cacheId} {
      allow read, create, update, delete: if true;
    }

    // Phase 7.17 - Staff, HR & Workforce Management Governance Engine
    match /staff_profiles/{staffId} {
      allow read, create, update, delete: if true;
    }

    match /staff_employment_history/{historyId} {
      allow read, create, update, delete: if true;
    }

    match /staff_qualifications/{qualId} {
      allow read, create, update, delete: if true;
    }

    match /staff_certifications/{certId} {
      allow read, create, update, delete: if true;
    }

    match /staff_skills/{skillId} {
      allow read, create, update, delete: if true;
    }

    match /staff_documents/{docId} {
      allow read, create, update, delete: if true;
    }

    match /staff_assignments/{assignmentId} {
      allow read, create, update, delete: if true;
    }

    match /staff_workload_snapshots/{snapshotId} {
      allow read, create, update, delete: if true;
    }

    match /staff_leave_types/{typeId} {
      allow read, create, update, delete: if true;
    }

    match /staff_leave_policies/{policyId} {
      allow read, create, update, delete: if true;
    }

    match /staff_leave_balances/{balanceId} {
      allow read, create, update, delete: if true;
    }

    match /staff_leave_requests/{requestId} {
      allow read, create, update, delete: if true;
    }

    match /staff_leave_transactions/{txId} {
      allow read, create, update, delete: if true;
    }

    match /staff_substitutions/{subId} {
      allow read, create, update, delete: if true;
    }

    match /staff_performance_cycles/{cycleId} {
      allow read, create, update, delete: if true;
    }

    match /staff_performance_reviews/{reviewId} {
      allow read, create, update, delete: if true;
    }

    match /staff_objectives/{objId} {
      allow read, create, update, delete: if true;
    }

    match /staff_compliance_records/{recId} {
      allow read, create, update, delete: if true;
    }

    match /staff_training_programs/{progId} {
      allow read, create, update, delete: if true;
    }

    match /staff_training_assignments/{assignId} {
      allow read, create, update, delete: if true;
    }

    match /staff_departments/{deptId} {
      allow read, create, update, delete: if true;
    }

    match /staff_designations/{desigId} {
      allow read, create, update, delete: if true;
    }

    match /staff_hr_cases/{caseId} {
      allow read, create, update, delete: if true;
    }

    match /staff_exit_cases/{exitId} {
      allow read, create, update, delete: if true;
    }

    match /staff_exit_clearances/{clearanceId} {
      allow read, create, update, delete: if true;
    }

    match /staff_handover_records/{handoverId} {
      allow read, create, update, delete: if true;
    }

    match /staff_analytics_cache/{cacheId} {
      allow read, create, update, delete: if true;
    }
    // Phase 7.19 Inventory Management
    match /inventory_stores/{id} {
      allow read, create, update, delete: if true;
    }
    match /inventory_categories/{id} {
      allow read, create, update, delete: if true;
    }
    match /inventory_items/{id} {
      allow read, create, update, delete: if true;
    }
    match /inventory_stocks/{id} {
      allow read, create, update, delete: if true;
    }
    match /inventory_stock_ledgers/{id} {
      allow read, create, update, delete: if true;
    }
    match /inventory_receipts/{id} {
      allow read, create, update, delete: if true;
    }
    match /inventory_issues/{id} {
      allow read, create, update, delete: if true;
    }
    match /inventory_returns/{id} {
      allow read, create, update, delete: if true;
    }
    match /inventory_transfers/{id} {
      allow read, create, update, delete: if true;
    }
    match /inventory_adjustments/{id} {
      allow read, create, update, delete: if true;
    }
    match /inventory_assets/{id} {
      allow read, create, update, delete: if true;
    }
    match /inventory_asset_assignments/{id} {
      allow read, create, update, delete: if true;
    }
    match /inventory_stock_audits/{id} {
      allow read, create, update, delete: if true;
    }
    match /inventory_analytics_cache/{id} {
      allow read, create, update, delete: if true;
    }

    // Phase 7.21 Alumni, Career Services, Internship & Placement Governance
    match /alumni_profiles/{id} {
      allow read, create, update, delete: if true;
    }
    match /corporate_partners/{id} {
      allow read, create, update, delete: if true;
    }
    match /job_postings/{id} {
      allow read, create, update, delete: if true;
    }
    match /placement_drives/{id} {
      allow read, create, update, delete: if true;
    }
    match /job_applications/{id} {
      allow read, create, update, delete: if true;
    }
    match /placement_offers/{id} {
      allow read, create, update, delete: if true;
    }
    match /career_mentorship_sessions/{id} {
      allow read, create, update, delete: if true;
    }
    match /alumni_events/{id} {
      allow read, create, update, delete: if true;
    }
    match /alumni_contributions/{id} {
      allow read, create, update, delete: if true;
    }
    match /alumni_placement_analytics/{id} {
      allow read, create, update, delete: if true;
    }

    // Phase 7.22 Learning Management, Digital Classroom & Teaching Delivery Governance
    match /learning_courses/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_course_versions/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_course_offerings/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_teaching_assignments/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_units/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_lessons/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_resources/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_resource_versions/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_digital_content/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_activities/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_assignments/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_assignment_submissions/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_quizzes/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_question_banks/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_questions/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_assessment_attempts/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_grade_records/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_discussions/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_discussion_messages/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_announcements/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_student_progress/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_course_completions/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_content_access_events/{id} {
      allow read, create, update, delete: if true;
    }
    match /learning_analytics_cache/{id} {
      allow read, create, update, delete: if true;
    }

    // Phase 7.23 Research, Innovation, Institutional Projects & Knowledge Assets Governance
    match /research_profiles/{id} {
      allow read, create, update, delete: if true;
    }
    match /research_projects/{id} {
      allow read, create, update, delete: if true;
    }
    match /research_proposals/{id} {
      allow read, create, update, delete: if true;
    }
    match /research_proposal_versions/{id} {
      allow read, create, update, delete: if true;
    }
    match /research_team_members/{id} {
      allow read, create, update, delete: if true;
    }
    match /research_milestones/{id} {
      allow read, create, update, delete: if true;
    }
    match /research_funding_references/{id} {
      allow read, create, update, delete: if true;
    }
    match /research_ethics_references/{id} {
      allow read, create, update, delete: if true;
    }
    match /research_outputs/{id} {
      allow read, create, update, delete: if true;
    }
    match /research_publications/{id} {
      allow read, create, update, delete: if true;
    }
    match /research_ip_records/{id} {
      allow read, create, update, delete: if true;
    }
    match /innovation_initiatives/{id} {
      allow read, create, update, delete: if true;
    }
    match /institutional_projects/{id} {
      allow read, create, update, delete: if true;
    }
    match /project_tasks/{id} {
      allow read, create, update, delete: if true;
    }
    match /project_risks/{id} {
      allow read, create, update, delete: if true;
    }
    match /project_issues/{id} {
      allow read, create, update, delete: if true;
    }
    match /research_knowledge_assets/{id} {
      allow read, create, update, delete: if true;
    }
    match /research_analytics_cache/{id} {
      allow read, create, update, delete: if true;
    }

    // Phase 7.24A Institutional Governance, Compliance, Accreditation & Quality Management
    match /governance_profiles/{id} {
      allow read, create, update, delete: if true;
    }
    match /governance_bodies/{id} {
      allow read, create, update, delete: if true;
    }
    match /governance_body_members/{id} {
      allow read, create, update, delete: if true;
    }
    match /governance_meetings/{id} {
